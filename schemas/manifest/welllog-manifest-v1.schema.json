{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paleo-workbench.local/schemas/welllog-manifest-v1.schema.json",
  "title": "WellLogEngine Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requiredSdkVersion", "document"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "requiredSdkVersion": {
      "const": ">=0.1.0 <1.0.0"
    },
    "document": {
      "$ref": "#/$defs/document"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "checksum", "byteOffset"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "checksum": {"type": "string"},
        "byteOffset": {"type": "integer", "minimum": 0}
      }
    },
    "buffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "length",
        "strideBytes",
        "scalarType",
        "byteCapacity"
      ],
      "properties": {
        "source": {"$ref": "#/$defs/source"},
        "length": {"type": "integer", "minimum": 1},
        "strideBytes": {"type": "integer", "minimum": 1},
        "scalarType": {
          "enum": [
            "float32",
            "float64",
            "int16",
            "int32",
            "int64",
            "uint8",
            "uint16",
            "uint32",
            "uint64"
          ]
        },
        "byteCapacity": {"type": "integer", "minimum": 1}
      }
    },
    "nullBitmap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "bitLength", "byteCapacity"],
      "properties": {
        "source": {"$ref": "#/$defs/source"},
        "bitLength": {"type": "integer", "minimum": 1},
        "byteCapacity": {"type": "integer", "minimum": 1}
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top"],
      "properties": {
        "left": {"type": "number"},
        "top": {"type": "number"}
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["r", "g", "b", "a"],
      "properties": {
        "r": {"type": "integer", "minimum": 0, "maximum": 255},
        "g": {"type": "integer", "minimum": 0, "maximum": 255},
        "b": {"type": "integer", "minimum": 0, "maximum": 255},
        "a": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "width", "height"],
      "properties": {
        "left": {"type": "number"},
        "top": {"type": "number"},
        "width": {"type": "number"},
        "height": {"type": "number"}
      }
    },
    "dashPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segments", "offset"],
      "properties": {
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "offset": {"type": "number"}
      }
    },
    "polyline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "closed", "color", "width", "points"],
      "properties": {
        "kind": {"const": "polyline"},
        "closed": {"type": "boolean"},
        "color": {"$ref": "#/$defs/color"},
        "width": {"type": "number"},
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/point"}
        },
        "dashPattern": {"$ref": "#/$defs/dashPattern"}
      }
    },
    "triangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "a", "b", "c", "fillColor"],
      "properties": {
        "kind": {"const": "triangle"},
        "a": {"$ref": "#/$defs/point"},
        "b": {"$ref": "#/$defs/point"},
        "c": {"$ref": "#/$defs/point"},
        "fillColor": {"$ref": "#/$defs/color"}
      }
    },
    "quad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rect", "fillColor"],
      "properties": {
        "kind": {"const": "quad"},
        "rect": {"$ref": "#/$defs/rect"},
        "fillColor": {"$ref": "#/$defs/color"},
        "patternId": {"$ref": "#/$defs/uuid"}
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "center", "symbol", "color", "size"],
      "properties": {
        "kind": {"const": "symbol"},
        "center": {"$ref": "#/$defs/point"},
        "symbol": {
          "enum": [
            "circle",
            "square",
            "triangleUp",
            "triangleDown",
            "diamond",
            "cross",
            "shoe"
          ]
        },
        "color": {"$ref": "#/$defs/color"},
        "size": {"type": "number"}
      }
    },
    "customPrimitive": {
      "oneOf": [
        {"$ref": "#/$defs/polyline"},
        {"$ref": "#/$defs/triangle"},
        {"$ref": "#/$defs/quad"},
        {"$ref": "#/$defs/symbol"}
      ]
    },
    "clipPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points"],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/point"}
        }
      }
    },
    "customSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contentRevision", "primitives"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "contentRevision": {"type": "integer", "minimum": 1},
        "primitives": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/customPrimitive"}
        },
        "clip": {"$ref": "#/$defs/clipPath"}
      }
    },
    "imageSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "widthPx",
        "heightPx",
        "pixelFormat",
        "referenceDepthTop",
        "referenceDepthBottom",
        "dpi",
        "source"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "widthPx": {"type": "integer", "minimum": 1},
        "heightPx": {"type": "integer", "minimum": 1},
        "pixelFormat": {"enum": ["rgba8", "rgb8", "r8"]},
        "referenceDepthTop": {"type": "number"},
        "referenceDepthBottom": {"type": "number"},
        "dpi": {"type": "integer", "minimum": 1},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "domain", "unit", "direction", "coordinates"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "domain": {"enum": ["md", "tvd", "tvdss", "sourceIndex"]},
        "unit": {"type": "string"},
        "direction": {"enum": ["increasing", "decreasing"]},
        "coordinates": {"$ref": "#/$defs/buffer"},
        "nominalInterval": {"type": "number"}
      }
    },
    "curve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mnemonic",
        "displayName",
        "unit",
        "samplingAxisId",
        "values",
        "nulls"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "mnemonic": {"type": "string"},
        "displayName": {"type": "string"},
        "unit": {"type": "string"},
        "samplingAxisId": {"$ref": "#/$defs/uuid"},
        "values": {"$ref": "#/$defs/buffer"},
        "nulls": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/nullBitmap"}
          ]
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "samplingAxes", "curves"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "revision": {"type": "integer", "minimum": 1},
        "samplingAxes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/axis"}
        },
        "curves": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/curve"}
        },
        "imageSources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/imageSource"}
        },
        "customSources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/customSource"}
        }
      }
    }
  }
}