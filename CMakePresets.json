{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "WellLogEngine development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "WELLLOG_BUILD_TESTS": "ON",
        "WELLLOG_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "dev-shared",
      "inherits": "dev",
      "displayName": "WellLogEngine shared-library development",
      "binaryDir": "${sourceDir}/build/dev-shared",
      "cacheVariables": {
        "WELLLOG_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "dev-vcpkg",
      "inherits": "dev",
      "displayName": "WellLogEngine development with pinned vcpkg",
      "binaryDir": "${sourceDir}/build/dev-vcpkg",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "dev-shared",
      "configurePreset": "dev-shared"
    },
    {
      "name": "dev-vcpkg",
      "configurePreset": "dev-vcpkg"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-shared",
      "configurePreset": "dev-shared",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-vcpkg",
      "configurePreset": "dev-vcpkg",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
